{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "48rem",
			"wideSize": "1000px"
		},
		"spacing": {
			"units": ["%", "px", "em", "rem", "vh", "vw", "ch"]
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"palette": [
				{ "slug": "background",       "color": "#f0fdfa", "name": "Background"       },
				{ "slug": "surface",          "color": "#fafafa", "name": "Surface"          },
				{ "slug": "surface-raised",   "color": "#f5f5f5", "name": "Surface Raised"   },
				{ "slug": "border",           "color": "#000000", "name": "Border"           },
				{ "slug": "text",             "color": "#3b0440", "name": "Text"             },
				{ "slug": "text-muted",       "color": "#737373", "name": "Text Muted"       },
				{ "slug": "white",            "color": "#ffffff", "name": "White"            },
				{ "slug": "primary",          "color": "#14b8a6", "name": "Primary"          },
				{ "slug": "primary-light",    "color": "#ccfbf1", "name": "Primary Light"    },
				{ "slug": "primary-dark",     "color": "#0f766e", "name": "Primary Dark"     },
				{ "slug": "secondary",        "color": "#f97316", "name": "Secondary" 		 },
				{ "slug": "secondary-light",  "color": "#ffedd5", "name": "Secondary Light"  },
				{ "slug": "secondary-dark",   "color": "#c2410c", "name": "Secondary Dark"   }
			]
		},
		"custom": {
			"font-size-base": "1rem",
			"color": {
				"orange-50":  "#fff7ed",
				"orange-100": "#ffedd5",
				"orange-200": "#fed7aa",
				"orange-300": "#fdba74",
				"orange-400": "#fb923c",
				"orange-500": "#f97316",
				"orange-600": "#ea580c",
				"orange-700": "#c2410c",
				"orange-800": "#9a3412",
				"orange-900": "#7c2d12",
				"teal-50":    "#f0fdfa",
				"teal-100":   "#ccfbf1",
				"teal-200":   "#99f6e4",
				"teal-300":   "#5eead4",
				"teal-400":   "#2dd4bf",
				"teal-500":   "#14b8a6",
				"teal-600":   "#0d9488",
				"teal-700":   "#0f766e",
				"teal-800":   "#115e59",
				"teal-900":   "#134e4a",
				"neutral-50":  "#fafafa",
				"neutral-100": "#f5f5f5",
				"neutral-200": "#e5e5e5",
				"neutral-300": "#d4d4d4",
				"neutral-400": "#a3a3a3",
				"neutral-500": "#737373",
				"neutral-600": "#525252",
				"neutral-700": "#404040",
				"neutral-800": "#262626",
				"neutral-900": "#171717"
			}
		},
		"typography": {
			"fluid": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "'Dancing Script', cursive",
					"fontFace": [
						{
							"fontFamily": "Dancing Script",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": ["file:./assets/fonts/DancingScript-Regular.ttf"]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "'Shadows Into Light', cursive",
					"fontFace": [
						{
							"fontFamily": "Shadows Into Light",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": ["file:./assets/fonts/ShadowsIntoLight-Regular.ttf"]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "sm",   "size": "0.875rem", "name": "SM"  },
				{ "slug": "md",   "size": "1rem",     "name": "MD"  },
				{ "slug": "lg",   "size": "1.25rem",  "name": "LG"  },
				{ "slug": "xl",   "size": "1.5rem",   "name": "XL"  },
				{ "slug": "xxl",  "size": "1.75rem",  "name": "2XL" },
				{ "slug": "xxxl", "size": "2rem",     "name": "3XL" }
			],
			"customFontSize": false,
			"defaultFontSizes": false
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--lg)",
			"lineHeight": "1.6"
		},
		"elements": {
			"h1": { "color": { "text": "var(--wp--preset--color--text)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--xxxl)", "lineHeight": "1.15" } },
			"h2": { "color": { "text": "var(--wp--preset--color--text)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--xxl)",  "lineHeight": "1.2"  } },
			"h3": { "color": { "text": "var(--wp--preset--color--text)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--xl)",   "lineHeight": "1.25" } },
			"h4": { "color": { "text": "var(--wp--preset--color--text)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--lg)",   "lineHeight": "1.3"  } },
			"h5": { "color": { "text": "var(--wp--preset--color--text)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--md)",   "lineHeight": "1.4"  } },
			"h6": { "color": { "text": "var(--wp--preset--color--text)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--sm)",   "lineHeight": "1.4"  } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)" },
				":hover": {
					"color": { "background": "#f099c6" }
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--primary)"
						},
						"border": {
							"color": "var(--wp--preset--color--primary)",
							"width": "2px",
							"style": "solid"
						}
					},
					"secondary": {
						"color": {
							"background": "var(--wp--preset--color--secondary)",
							"text": "var(--wp--preset--color--white)"
						}
					},
					"outline-secondary": {
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--secondary)"
						},
						"border": {
							"color": "var(--wp--preset--color--secondary)",
							"width": "2px",
							"style": "solid"
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{ "area": "header", "name": "header" },
		{ "area": "footer", "name": "footer" }
	],
	"version": 3
} 